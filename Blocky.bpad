<?xml version="1.0" encoding="utf-8"?>
<document version="1.9" language="en-us">
    <include target="Library.DateTime" />
    <include target="Library.Math" />
    <include target="Library.Logic" />
    <include target="Library.Lookup" />
    <include target="Library.Statistics" />
    <include target="Library.Text" />
    <include target="Library.Scripts" />
    <report name="Report1" title="Report 1" unit="in" pagesize="816, 1056">
        <heading>Library Blocks</heading>
        <paragraph />
        <paragraph>Calling "ApplyBlock" to a library block definition:</paragraph>
        <paragraph>
            <dynexp formula="Blocky.ApplyBlock(Library.Examples.Rectangle, [&quot;Length&quot;, &quot;Width&quot;], [20 ft, 10 ft])" fontsize="8">
                <expbody>Blocky.ApplyBlock(Library.Examples.Rectangle, ["Length", "Width"], [20 ft, 10 ft])</expbody>
                <expresult> = {Length: 20 ft, Width: 10 ft, TextboxOrigin: , Perimeter: 60 ft, Area: 200 ft^2, Diagonal: 22.361 ft}</expresult>
            </dynexp>
        </paragraph>
        <paragraph />
        <paragraph>Instance of library block (MyLibraryBlock)</paragraph>
        <block name="MyLibraryBlock" title="Block 2" definition="Library.Examples.Rectangle">
            <parameters>
                <param name="Length"><num>5 in</num></param>
                <param name="Width"><num>3 in</num></param>
                <param name="TextboxOrigin" />
            </parameters>
            <content>
                <heading level="3">Rectangle Properties</heading>
                <paragraph />
                <embed>
                    <canvas title="Canvas 1" name="Canvas1" unit="in" size="6.5 in; 2.1 in; scaletofit" scale="0.7">
                        <include target="Library.Geometry" />
                        <lines pts="1.1033950617284, 1.71422067901234, 0; 1.1033950617284, 0.602469135802469, 0" linethickness="1.5" />
                        <lines pts="1.1033950617284, 0.602469135802469, 0; 3.6658950617284, 0.602469135802469, 0" linethickness="1.5" />
                        <lines pts="3.6658950617284, 0.602469135802469, 0; 3.6658950617284, 1.71422067901234, 0" linethickness="1.5" />
                        <lineardim startpoint="1.1033950617284, 0.602469135802469, 0" endpoint="1.1033950617284, 1.71422067901234, 0" pointondimline="0.381172839506174, 1.58890046296296, 0" linethickness="1" linecolor="#B2B2B2" refformula="Width"><num>3 in</num></lineardim>
                        <lines pts="1.1033950617284, 1.71422067901234, 0; 3.6658950617284, 0.602469135802469, 0" linethickness="1" linecolor="#B2B2B2" />
                        <lineardim startpoint="1.1033950617284, 0.602469135802469, 0" endpoint="3.6658950617284, 0.602469135802469, 0" pointondimline="3.55478395061728, 0.324691358024692, 0" linethickness="1" linecolor="#B2B2B2" refformula="Length"><num>5 in</num></lineardim>
                        <lineardim startpoint="1.1033950617284, 1.71422067901234, 0" endpoint="3.6658950617284, 0.602469135802469, 0" pointondimline="2.92779048271661, 2.1488386126335, 0" linethickness="1" linecolor="#B2B2B2" refformula="Diagonal"><num>5.830951894845301 in</num></lineardim>
                        <lines pts="1.1033950617284, 1.71422067901234, 0; 3.6658950617284, 1.71422067901234, 0" linethickness="1.5" />
                        <planecontainer origin="4.55246913580247, 0.411496913580247, 0" dir="0.39351851851851904, 0, 0" normal="0, 0, 0.15485682441701"><textvalue>*image not to scale</textvalue></planecontainer>
                    </canvas>
                </embed>
                <paragraph />
                <paragraph>
                    <dynexp mathlayout="on" formula="Length=5 in">
                        <expbody>Length=5 in</expbody>
                    </dynexp>
                    <break type="tab" />
                    <break type="tab" />
                    <dynexp mathlayout="on" formula="Width=3 in">
                        <expbody>Width=3 in</expbody>
                    </dynexp>
                </paragraph>
                <paragraph />
                <paragraph>
                    <dynexp mathlayout="on" formula="Perimeter = 2*(Length + Width)">
                        <expbody>Perimeter = 2*(Length + Width)</expbody>
                        <expresult> = 16 in</expresult>
                    </dynexp>
                    <break type="tab" />
                    <break type="tab" />
                </paragraph>
                <paragraph />
                <paragraph>
                    <dynexp mathlayout="on" formula="Area = Length*Width">
                        <expbody>Area = Length*Width</expbody>
                        <expresult> = 15 in^2</expresult>
                    </dynexp>
                </paragraph>
                <paragraph />
                <paragraph>
                    <dynexp mathlayout="on" formula="Diagonal = Sqrt(Length^2 + Width^2)">
                        <expbody>Diagonal = Sqrt(Length^2 + Width^2)</expbody>
                        <expresult> = 5.831 in</expresult>
                    </dynexp>
                </paragraph>
                <paragraph />
            </content>
        </block>
        <paragraph />
        <paragraph>Calling "ApplyBlock" on an instance of a library block (MyLibraryBlock)</paragraph>
        <paragraph>
            <dynexp formula="Blocky.ApplyBlock(MyLibraryBlock, [&quot;Length&quot;, &quot;Width&quot;], [20 ft, 10 ft])" fontsize="8">
                <expbody>Blocky.ApplyBlock(MyLibraryBlock, ["Length", "Width"], [20 ft, 10 ft])</expbody>
                <expresult> = {Length: 20 ft, Width: 10 ft, TextboxOrigin: , Perimeter: 60 ft, Area: 200 ft^2, Diagonal: 22.361 ft}</expresult>
            </dynexp>
        </paragraph>
        <break type="page" />
        <heading>Local Blocks</heading>
        <paragraph />
        <paragraph>Local block source (change this section, hit F5, and it propagates through the document)</paragraph>
        <section name="Section1" capture="True">
            <paragraph>
                <dynexp formula="a=2">
                    <expbody>a=2</expbody>
                </dynexp>
            </paragraph>
            <paragraph>
                <dynexp formula="b=5">
                    <expbody>b=5</expbody>
                </dynexp>
            </paragraph>
            <paragraph>
                <dynexp formula="c=2*a+b/2">
                    <expbody>c=2*a+b/2</expbody>
                    <expresult> = 6.5</expresult>
                </dynexp>
            </paragraph>
        </section>
        <paragraph />
        <paragraph>Local block definition (for reference):</paragraph>
        <paragraph>
            <valuefield type="inline" name="LocalBlockDefinition" showidentifier="False"><textvalue>Library.Docs.ScenarioDefinition(nodeof(Report1.Section1), {a: nodeof(Report1.Section1.a), b: nodeof(Report1.Section1.b)}, {c: nodeof(Report1.Section1.c)})</textvalue></valuefield>
        </paragraph>
        <paragraph />
        <paragraph>Local block instance:</paragraph>
        <block name="MyLocalBlock" title="Block 1" definition="Library.Docs.ScenarioDefinition(nodeof(Report1.Section1), {a: nodeof(Report1.Section1.a), b: nodeof(Report1.Section1.b)}, {c: nodeof(Report1.Section1.c)})">
            <parameters>
                <param name="a"><num>9</num></param>
                <param name="b"><num>20</num></param>
                <param name="TextboxOrigin" />
            </parameters>
            <content>
                <paragraph>
                    <dynexp formula="a=9">
                        <expbody>a=9</expbody>
                    </dynexp>
                </paragraph>
                <paragraph>
                    <dynexp formula="b=20">
                        <expbody>b=20</expbody>
                    </dynexp>
                </paragraph>
                <paragraph>
                    <dynexp formula="c=2*a+b/2">
                        <expbody>c=2*a+b/2</expbody>
                        <expresult> = 28</expresult>
                    </dynexp>
                </paragraph>
            </content>
        </block>
        <paragraph />
        <paragraph>Calling "ApplyBlock" on an instance of a local block (MyLocalBlock)</paragraph>
        <paragraph>
            <dynexp formula="Blocky.ApplyBlock(MyLocalBlock, [&quot;a&quot;, &quot;b&quot;], [200, 150])" fontsize="8">
                <expbody>Blocky.ApplyBlock(MyLocalBlock, ["a", "b"], [200, 150])</expbody>
                <expresult> = {a: 200, b: 150, TextboxOrigin: , c: 475}</expresult>
            </dynexp>
        </paragraph>
        <paragraph />
        <paragraph>Calling "ApplyBlock" with the full local block definition (not recommended, but possible):</paragraph>
        <paragraph>
            <dynexp formula="Value1=Blocky.ApplyBlock(Library.Docs.ScenarioDefinition(nodeof(Report1.Section1), {a: nodeof(Report1.Section1.a), b: nodeof(Report1.Section1.b)}, {c: nodeof(Report1.Section1.c)}), [&quot;a&quot;, &quot;b&quot;], [200, 150])" fontsize="8" showidentifier="False">
                <expbody>Blocky.ApplyBlock(Library.Docs.ScenarioDefinition(nodeof(Report1.Section1), {a: nodeof(Report1.Section1.a), b: nodeof(Report1.Section1.b)}, {c: nodeof(Report1.Section1.c)}), ["a", "b"], [200, 150])</expbody>
                <expresult> = {a: 200, b: 150, TextboxOrigin: , c: 475}</expresult>
            </dynexp>
        </paragraph>
        <paragraph />
        <paragraph />
        <break type="page" />
        <heading>Array &lt;-&gt; Dict</heading>
        <paragraph />
        <paragraph>To make this possible, I added the routine "ArrayToDict", which does the reverse of "Library.Scripts.KeysAndValues".</paragraph>
        <paragraph />
        <paragraph>
            <dynexp formula="ArrayInputs=[&quot;a&quot;,5;&quot;b&quot;,10]" showformula="True" showsteps="false" showresult="True">
                <expbody>ArrayInputs=["a",5;"b",10]</expbody>
            </dynexp>
        </paragraph>
        <paragraph>
            <dynexp formula="DictInputs=Blocky.ArrayToDict(ArrayInputs)">
                <expbody>DictInputs=Blocky.ArrayToDict(ArrayInputs)</expbody>
                <expresult> = {a: 5, b: 10}</expresult>
            </dynexp>
        </paragraph>
        <paragraph>Note that calling "KeysAndValues" reverses this operation.</paragraph>
        <paragraph>
            <dynexp formula="KeysAndValues(DictInputs)">
                <expbody>KeysAndValues(DictInputs)</expbody>
                <expresult> = [a, 5; ...]</expresult>
            </dynexp>
        </paragraph>
        <paragraph />
        <paragraph>The dictionary produced by ArrayToDict can be passed as inputs to a block definition.</paragraph>
        <paragraph>
            <dynexp formula="MyLocalBlock.BlockDefinition(DictInputs)">
                <expbody>MyLocalBlock.BlockDefinition(DictInputs)</expbody>
                <expresult> = {a: 5, b: 10, TextboxOrigin: , c: 15}</expresult>
            </dynexp>
        </paragraph>
        <paragraph />
        <paragraph>So, the ApplyBlock routine first converts the vectors of keys and values to a vertical array (same format as "KeysAndValues"), and then converts that to a dictionary for input into the block.</paragraph>
        <paragraph />
        <break type="page" />
        <heading>Native Block Tables</heading>
        <paragraph />
        <paragraph>Now, with the ApplyBlock function, you can easily create a blocktable.</paragraph>
        <paragraph>For visual simplicity, the column with "Block" is formatted such that the result does not show.</paragraph>
        <paragraph />
        <paragraph>Local block</paragraph>
        <embed>
            <table name="Table1" title="Table 1">
                <stylerule range="A1:D1" fontweight="bold" />
                <stylerule range="A1:D5" border="&#xA;    Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); &#xA;    Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); &#xA;    Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); " />
                <stylerule range="C3:C5" showresult="False" />
                <row>
                    <c><textvalue>a</textvalue></c>
                    <c><textvalue>b</textvalue></c>
                    <c><textvalue>Block</textvalue></c>
                    <c><textvalue>c</textvalue></c>
                </row>
                <row>
                    <c><num>1</num></c>
                    <c><num>40</num></c>
                    <c formula="Blocky.ApplyBlock(MyLocalBlock, $A$1:$B$1, A2:B2)" showresult="False" />
                    <c formula="$C2[D$1]"><num>22</num></c>
                </row>
                <row>
                    <c><num>2</num></c>
                    <c><num>60</num></c>
                    <c formula="Blocky.ApplyBlock(MyLocalBlock, $A$1:$B$1, A3:B3)" />
                    <c formula="$C3[D$1]"><num>34</num></c>
                </row>
                <row>
                    <c><num>3</num></c>
                    <c><num>80</num></c>
                    <c formula="Blocky.ApplyBlock(MyLocalBlock, $A$1:$B$1, A4:B4)" />
                    <c formula="$C4[D$1]"><num>46</num></c>
                </row>
                <row>
                    <c><num>4</num></c>
                    <c><num>100</num></c>
                    <c formula="Blocky.ApplyBlock(MyLocalBlock, $A$1:$B$1, A5:B5)" />
                    <c formula="$C5[D$1]"><num>58</num></c>
                </row>
            </table>
        </embed>
        <paragraph />
        <paragraph>Defining the block column:</paragraph>
        <paragraph>
            <image source="Resource3" />
        </paragraph>
        <paragraph />
        <paragraph />
        <paragraph>Defining the properties column (this allows you to drag it down and across for all output values).</paragraph>
        <paragraph>
            <image source="Resource1" />
        </paragraph>
        <paragraph />
        <paragraph>Example with more outputs: Library.Examples.Rectangle</paragraph>
        <paragraph />
        <embed>
            <table name="Table2" title="Table 2">
                <stylerule range="A1:F1" fontweight="bold" />
                <stylerule range="A1:F5" border="&#xA;    Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); &#xA;    Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); &#xA;    Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); " />
                <stylerule range="C3:C5" showresult="False" />
                <row>
                    <c><textvalue>Length</textvalue></c>
                    <c><textvalue>Width</textvalue></c>
                    <c><textvalue>Block</textvalue></c>
                    <c><textvalue>Perimeter</textvalue></c>
                    <c><textvalue>Area</textvalue></c>
                    <c><textvalue>Diagonal</textvalue></c>
                </row>
                <row>
                    <c><num>3 in</num></c>
                    <c><num>4 in</num></c>
                    <c formula="Blocky.ApplyBlock(Library.Examples.Rectangle, $A$1:$B$1, A2:B2)" showresult="False" />
                    <c formula="$C2[D$1]"><num>14 in</num></c>
                    <c formula="$C2[E$1]"><num>12 in^2</num></c>
                    <c formula="$C2[F$1]"><num>5 in</num></c>
                </row>
                <row>
                    <c><num>10 in</num></c>
                    <c><num>10 in</num></c>
                    <c formula="Blocky.ApplyBlock(Library.Examples.Rectangle, $A$1:$B$1, A3:B3)" />
                    <c formula="$C3[D$1]"><num>40 in</num></c>
                    <c formula="$C3[E$1]"><num>100 in^2</num></c>
                    <c formula="$C3[F$1]"><num>14.142135623730951 in</num></c>
                </row>
                <row>
                    <c><num>1 in</num></c>
                    <c><num>10 in</num></c>
                    <c formula="Blocky.ApplyBlock(Library.Examples.Rectangle, $A$1:$B$1, A4:B4)" />
                    <c formula="$C4[D$1]"><num>22 in</num></c>
                    <c formula="$C4[E$1]"><num>10 in^2</num></c>
                    <c formula="$C4[F$1]"><num>10.04987562112089 in</num></c>
                </row>
                <row>
                    <c><num>2 in</num></c>
                    <c><num>3 in</num></c>
                    <c formula="Blocky.ApplyBlock(Library.Examples.Rectangle, $A$1:$B$1, A5:B5)" />
                    <c formula="$C5[D$1]"><num>10 in</num></c>
                    <c formula="$C5[E$1]"><num>6 in^2</num></c>
                    <c formula="$C5[F$1]"><num>3.605551275463989 in</num></c>
                </row>
            </table>
        </embed>
        <paragraph />
        <paragraph />
    </report>
    <script name="Blocky" title="Blocky" type="Module">// Routines for helping with making native block tables
// Written by Alex Baker, 2026

include(Library.Lookup);

// ArrayToDict converts an array to a dictionary. 
// The reverse is "Library.Scripts.KeysAndValues".
Module.ArrayToDict = (array) =&gt; {
    var result = {};
    if (Columns(array) != 2) {
        return "error: want a 2-column input array";
    }
    for (i = 1; i &lt;= Rows(array); i++) {
        result[array(i,1)] = array(i,2);
    }
    return result;
};

// ApplyBlock passes keys and values to a block or block definition, in a format that is conducive to block tables.
Module.ApplyBlock = (block,keys,values) =&gt; {
    // Only accept row vectors
    if (Rows(keys) != 1 || Rows(values) != 1) {
        return "error: want row vectors for keys and values";
    }
    if (Columns(keys) != Columns(values)) {
        return "error: key and value inputs must be same length";
    }
    try {
        result = block.BlockDefinition(Module.ArrayToDict(Transpose(ConcatRows(keys,values))));
    } catch {
        result = block(Module.ArrayToDict(Transpose(ConcatRows(keys,values))));
    }
    return result;
};</script>
